<Window
    x:Class="Ariketa1_Unitatea3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Ariketa1_Unitatea3"
    Title="Garraio Erreserba Sistema"
    Width="800"
    Height="450">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <TabControl
            x:Name="TabGarraioak"
            Grid.Column="0"
            SelectionChanged="TabGarraioak_SelectionChanged">
            <TabItem Header="Autobusa">
                <local:SeatMapControl
                    x:Name="BusMap"
                    AccentColor="Yellow"
                    Columns="4"
                    Rows="6" />
            </TabItem>
            <TabItem Header="Trena">
                <local:SeatMapControl
                    x:Name="TrainMap"
                    AccentColor="Yellow"
                    Columns="6"
                    Rows="8" />
            </TabItem>
            <TabItem Header="Hegazkina">
                <local:SeatMapControl
                    x:Name="PlaneMap"
                    AccentColor="Yellow"
                    Columns="3"
                    Rows="10" />
            </TabItem>
        </TabControl>

        <StackPanel
            Grid.Column="1"
            Margin="10"
            VerticalAlignment="Center">
            <TextBlock
                Margin="0,0,0,5"
                FontWeight="Bold"
                Text="Erreserba Data:" />
            <DatePicker
                x:Name="DpErreserbaData"
                Margin="0,0,0,15"
                SelectedDateChanged="DpErreserbaData_SelectedDateChanged" />

            <Button
                Margin="0,0,0,10"
                Padding="8"
                Background="#4CAF50"
                Click="BtnErreserbatu_Click"
                Content="Erreserba Baieztatu"
                Foreground="White" />
            <Button
                Padding="8"
                Background="#F44336"
                Click="BtnEzabatu_Click"
                Content="Erreserba Bertan Behera Utzi"
                Foreground="White" />
        </StackPanel>
    </Grid>
</Window>