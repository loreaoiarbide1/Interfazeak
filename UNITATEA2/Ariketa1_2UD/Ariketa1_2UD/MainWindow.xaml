<Window
    x:Class="Ariketa1_2UD.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ariketa1_2UD"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Ataza-kudeatzailea"
    Width="750"
    Height="450"
    Closing="Window_Closing"
    Loaded="Window_Loaded"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  DataGrid (Irakurtzeko soilik, leiho berriaren bidez editatuko da)  -->
        <DataGrid
            Name="dgAtazak"
            Grid.Row="0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            GridLinesVisibility="All"
            IsReadOnly="True"
            MouseDoubleClick="dgAtazak_MouseDoubleClick"
            RowHeaderWidth="0"
            SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Izenburua}"
                    Header="Titulua"
                    IsReadOnly="True"
                    />

                <DataGridTextColumn
                    Width="130"
                    Binding="{Binding Lehentasuna}"
                    Header="Lehentasuna"
                    IsReadOnly="True"
                    />

                <DataGridTextColumn
                    Width="130"
                    Binding="{Binding MugaEguna, StringFormat=yyyy-MM-dd}"
                    Header="Azken eguna"
                    IsReadOnly="True"
                    />

                <DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding Eginda}"
                    Header="Egina" />

            </DataGrid.Columns>
        </DataGrid>

        <!--  Beheko Botoiak  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Width="65"
                Height="23"
                Margin="0,0,4,0"
                Click="btnBerria_Click"
                Content="Berria" />

            <Button
                Width="65"
                Height="23"
                Margin="0,0,4,0"
                Click="btnEditatu_Click"
                Content="Editatu" />

            <Button
                Width="65"
                Height="23"
                Margin="0,0,4,0"
                Click="btnEzabatu_Click"
                Content="Ezabatu" />

            <Button
                Width="65"
                Height="23"
                Click="btnIrten_Click"
                Content="Irten" />

        </StackPanel>
    </Grid>
</Window>