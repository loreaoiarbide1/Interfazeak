<Window
    x:Class="Ariketa10.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ariketa10"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Label
            Margin="329,39,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="NIRE IRUDIAK"
            FontWeight="Bold" />
        
        <Label
            Width="72"
            Margin="84,76,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="1. ilara" />
        
        <ComboBox
            x:Name="CmbIrudiak"
            Width="120"
            Margin="84,107,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            SelectionChanged="CmbIrudiak_SelectionChanged" />
        
        <Label
            Width="58"
            Margin="84,265,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="2. ilara" />
        
        <CheckBox
            x:Name="CbhIrudia4"
            Width="120"
            Margin="84,296,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Checked="CbhIrudia_CheckedChanged"
            Content="Irudia 4"
            Unchecked="CbhIrudia_CheckedChanged" />
        
        <CheckBox
            x:Name="CbhIrudia5"
            Width="120"
            Margin="84,335,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Checked="CbhIrudia_CheckedChanged"
            Content="Irudia 5"
            Unchecked="CbhIrudia_CheckedChanged" />
        
        <CheckBox
            x:Name="CbhIrudia6"
            Width="120"
            Margin="84,370,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Checked="CbhIrudia_CheckedChanged"
            Content="Irudia 6"
            Unchecked="CbhIrudia_CheckedChanged" />
        
        <Button
            x:Name="BtnIrten"
            Width="83"
            Height="28"
            Margin="641,378,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BtnIrten_Click"
            Content="Irten" />
        
        <Image
            x:Name="Img1"
            Width="105"
            Height="82"
            Margin="284,107,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Source="/Irudiak/Irudia1.png"
            Stretch="Fill"
            Visibility="Hidden" />
        
        <Image
            x:Name="Img2"
            Width="105"
            Height="82"
            Margin="424,107,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Source="/Irudiak/Irudia2.png"
            Stretch="Fill"
            Visibility="Hidden" />
        <Image
            x:Name="Img3"
            Width="95"
            Height="82"
            Margin="555,107,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Source="/Irudiak/Irudia3.png"
            Stretch="Fill"
            Visibility="Hidden" />
        
        <Image
            x:Name="Img4"
            Width="125"
            Height="93"
            Margin="209,296,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Source="/Irudiak/Irudia4.png"
            Stretch="Fill"
            Visibility="Hidden" />
        
        <Image
            x:Name="Img5"
            Width="122"
            Height="83"
            Margin="355,297,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Source="/Irudiak/Irudia5.png"
            Stretch="Fill"
            Visibility="Hidden" />
        
        <Image
            x:Name="Img6"
            Width="93"
            Height="87"
            Margin="500,296,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Source="/Irudiak/Irudia6.png"
            Stretch="Fill"
            Visibility="Hidden" />
    </Grid>
</Window>

