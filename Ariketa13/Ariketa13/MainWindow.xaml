<Window
    x:Class="Ariketa13.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ariketa13"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="900"
    Height="600"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F0F0F0">
            <MenuItem x:Name="MenuFitxategia" Header="FITXATEGIA">
                <MenuItem
                    Click="MenuIreki_Click"
                    Header="Ireki"
                    InputGestureText="Ctrl+O" />
                <MenuItem
                    Click="MenuGorde_Click"
                    Header="Gorde"
                    InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Click="MenuIrten_Click" Header="Irten" />
            </MenuItem>

            <MenuItem x:Name="MenuEditatu" Header="EDITATU">
                <MenuItem
                    Click="MenuEbaki_Click"
                    Header="Moztu"
                    InputGestureText="Ctrl+X" />
                <MenuItem
                    Click="MenuKopiatu_Click"
                    Header="Kopiatu"
                    InputGestureText="Ctrl+C" />
                <MenuItem
                    Click="MenuItsatsi_Click"
                    Header="Itsatsi"
                    InputGestureText="Ctrl+V" />
                <Separator />
                <MenuItem
                    Click="MenuEzabatu_Click"
                    Header="Ezabatu"
                    InputGestureText="Supr" />
            </MenuItem>

            <MenuItem x:Name="MenuIturria" Header="ITURRIA">
                <MenuItem Click="MenuIturria_Arial_Click" Header="Arial" />
                <MenuItem Click="MenuIturria_Courier_Click" Header="Courier" />
                <MenuItem Click="MenuIturria_Impact_Click" Header="Impact" />
                <MenuItem Click="MenuIturria_Symbol_Click" Header="Symbol" />
            </MenuItem>
        </Menu>

        <TextBox
            x:Name="txtEditorea"
            Grid.Row="1"
            Padding="10"
            AcceptsReturn="True"
            FontFamily="Arial"
            FontSize="14"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>