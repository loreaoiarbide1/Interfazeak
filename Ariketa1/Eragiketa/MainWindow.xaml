<Window
    x:Class="Eragiketa.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Eragiketa"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Label
            x:Name="LehenZenbakia"
            Width="120"
            Margin="89,53,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Red"
            Content="Lehen zenbakia" />

        <TextBox
            x:Name="txtLehengoZenbakia"
            Width="120"
            Margin="224,57,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            PreviewTextInput="txtZenbakiak_PreviewTextInput"
            Text=""
            TextWrapping="Wrap"
            TextChanged="TextBox_TextChanged" />

        <TextBlock
            x:Name="errLehengoZenbakia"
            Foreground="Red"
            Margin="224,80,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Text="Derrigorrezkoa / Sartu baliozko zenbaki bat." />

        <Label
            x:Name="BigarrenZenbakia"
            Width="120"
            Margin="89,102,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Red"
            Content="Bigarren zenbakia" />

        <TextBox
            x:Name="txtBigarrenZenbakia"
            PreviewTextInput="txtZenbakiak_PreviewTextInput"
            Width="120"
            Margin="224,110,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text=""
            TextWrapping="Wrap"
            TextChanged="TextBox_TextChanged" />

        <TextBlock
            x:Name="errBigarrenZenbakia"
            Foreground="Red"
            Margin="224,133,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Text="Derrigorrezkoa / Sartu baliozko zenbaki bat." />

        <Label
            x:Name="HirugarrenZenbakia"
            Width="120"
            Margin="89,151,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Red"
            Content="Hirugarren zenbakia" />

        <TextBox
            x:Name="txtHirugarrenZenbakia"
            PreviewTextInput="txtZenbakiak_PreviewTextInput"
            Width="120"
            Margin="224,155,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text=""
            TextWrapping="Wrap"
            TextChanged="TextBox_TextChanged" />

        <TextBlock
            x:Name="errHirugarrenZenbakia"
            Foreground="Red"
            Margin="224,178,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Text="Derrigorrezkoa / Sartu baliozko zenbaki bat." />

        <Label
            Width="120"
            Margin="89,191,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Red"
            Content="Laugarren zenbakia" />

        <TextBox
            x:Name="txtLaugarrenZenbakia"
            PreviewTextInput="txtZenbakiak_PreviewTextInput"
            Width="120"
            Margin="224,195,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text=""
            TextWrapping="Wrap"
            TextChanged="TextBox_TextChanged" />

        <TextBlock
            x:Name="errLaugarrenZenbakia"
            Foreground="Red"
            Margin="224,218,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Text="Derrigorrezkoa / Sartu baliozko zenbaki bat." />

        <Label
            x:Name="Emaitza"
            Margin="89,246,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Blue"
            Content="EMAITZA" />

        <TextBox
            x:Name="txtEmaitza"
            Width="120"
            Margin="224,246,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsReadOnly="True"
            Text=""
            TextWrapping="Wrap" />

        <Button
            x:Name="btnKalkulatu"
            Margin="89,316,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btnKalkulatu_Click"
            Content="Kalkulatu" />

        <Button
            x:Name="btnGarbitu"
            Margin="224,316,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btnGarbitu_Click"
            Content="Garbitu" />

        <Button
            x:Name="btnIrten"
            Margin="360,316,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btnIrten_Click"
            Content="Irten" />
    </Grid>
</Window>
