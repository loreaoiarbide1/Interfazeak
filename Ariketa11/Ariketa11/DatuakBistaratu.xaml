<Window
    x:Class="Ariketa11.DatuakBistaratu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DatuakBistaratu"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Label
            Margin="106,60,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Izena :" />

        <TextBlock
            x:Name="TxtBIzena"
            Width="120"
            Margin="247,60,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />

        <Label
            Margin="106,115,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="1. abizena :" />

        <TextBlock
            x:Name="TxtBAbizena1"
            Width="120"
            Margin="247,115,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />

        <Label
            Margin="106,167,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="2. abizena :" />

        <TextBlock
            x:Name="TxtBAbizena2"
            Width="120"
            Margin="247,167,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />

        <Label
            Margin="106,226,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="NAN :" />

        <TextBlock
            x:Name="TxtBNAN"
            Width="120"
            Margin="247,226,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />

        <Button
            x:Name="BtnIrten"
            Width="78"
            Height="26"
            Margin="110,308,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BtnIrten_Click"
            Content="Irten" />
        <Label Content="Ongi etorri sistemara" HorizontalAlignment="Left" Margin="317,21,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
    </Grid>
</Window>