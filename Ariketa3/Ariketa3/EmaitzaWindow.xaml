<Window
    x:Class="Ariketa3.EmaitzaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ariketa3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EmaitzaWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Margin="40" VerticalAlignment="Center">
            <Label
            Content="Emaitza:"
            FontSize="16"
            FontWeight="Bold" />

            <TextBox
            x:Name="txtEmaitza"
            Height="50"
            Margin="0,10,0,30"
            Padding="10"
            FontSize="18"
            IsReadOnly="True"
            TextWrapping="Wrap" />

            <Button
            x:Name="btnIrten"
            Width="150"
            Padding="10"
            HorizontalAlignment="Center"
            Click="btnIrten_Click"
            Content="Irten"
            FontSize="12" />
        </StackPanel>
    </Grid>
</Window>
