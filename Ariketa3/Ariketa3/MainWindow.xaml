<Window
    x:Class="Ariketa3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ariketa3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Label
            x:Name="lblZenbakia"
            Width="69"
            Height="26"
            Margin="57,83,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="1. zenbakia" />

        <TextBox
            x:Name="txtZenbakia"
            Width="120"
            Height="18"
            Margin="126,91,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            TextWrapping="Wrap" />

        <Button
            x:Name="btnHurrengoa"
            Width="86"
            Height="20"
            Margin="57,170,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btnHurrengoa_Click"
            Content="Hurrengoa" />

        <Button
            x:Name="btnGarbitu"
            Width="120"
            Padding="10"
            Click="btnGarbitu_Click"
            Content="Garbitu"
            FontSize="12"
            Visibility="Collapsed" />

        <Button
            x:Name="btnIrten"
            Width="80"
            Height="20"
            Margin="166,170,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btnIrten_Click"
            Content="Irten" />

    </Grid>
</Window>
