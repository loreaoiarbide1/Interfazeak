<Window
    x:Class="Ariketa12.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ariketa12"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  1. Dietak (GroupBox)  -->
        <GroupBox
            Grid.Column="0"
            Margin="5,5,5,303"
            Header="Dietak">
            <StackPanel Margin="5">
                <CheckBox
                    x:Name="chkGosaria"
                    Margin="0,5"
                    Content="Gosaria" />
                <CheckBox
                    x:Name="chkBazkaria"
                    Margin="0,5"
                    Content="Bazkaria" />
                <CheckBox
                    x:Name="chkAfaria"
                    Margin="0,5"
                    Content="Afaria" />
            </StackPanel>
        </GroupBox>

        <!--  2. Bidaiak (GroupBox)  -->
        <GroupBox
            Grid.Column="1"
            Margin="5,5,5,303"
            Header="Bidaiak">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="KM" />

                <TextBox
                    x:Name="txtKm"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="60"
                    Margin="5"
                    HorizontalAlignment="Left" />

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="Orduak" />

                <TextBox
                    x:Name="txtBidaiaOrdua"
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="60"
                    Margin="5"
                    HorizontalAlignment="Left" />
            </Grid>
        </GroupBox>

        <!--  3. Lana (GroupBox)  -->
        <GroupBox
            Grid.Column="2"
            Margin="5,5,5,303"
            Header="Lana">
            <StackPanel
                Margin="5"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Label VerticalAlignment="Center" Content="Orduak" />
                <TextBox
                    x:Name="txtLanaOrdua"
                    Width="60"
                    Height="25"
                    Margin="5"
                    VerticalAlignment="Center" />
            </StackPanel>
        </GroupBox>

        <TextBox
            x:Name="TxtDietakPrezioa"
            Width="120"
            Height="28"
            Margin="30,189,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsReadOnly="True"
            TextWrapping="Wrap" />

        <TextBox
            x:Name="TxtBidaiakPrezioa"
            Grid.Column="1"
            Width="120"
            Height="28"
            Margin="26,189,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsReadOnly="True"
            TextWrapping="Wrap" />

        <TextBox
            x:Name="TxtLanaPrezioa"
            Grid.Column="2"
            Width="120"
            Height="28"
            Margin="25,189,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsReadOnly="True"
            TextWrapping="Wrap" />

        <Button
            x:Name="BtnGarbitu"
            Width="120"
            Height="26"
            Margin="30,301,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BtnGarbitu_Click"
            Content="Garbitu" />

        <Button
            x:Name="BtnIrten"
            Grid.Column="1"
            Width="120"
            Height="26"
            Margin="26,301,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BtnIrten_Click"
            Content="Irten" />

        <Label
            Grid.Column="2"
            Width="90"
            Margin="5,298,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="GUZTIRA"
            FontSize="16"
            FontWeight="Bold" />

        <TextBox
            x:Name="TxtPrezioaGuztira"
            Grid.Column="2"
            Width="120"
            Height="25"
            Margin="111,302,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#FF95B0BE"
            IsReadOnly="True"
            TextWrapping="Wrap" />
        
        <Rectangle
            Grid.ColumnSpan="3"
            Width="689"
            Height="1"
            Margin="30,243,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            RenderTransformOrigin="0.5,0.5"
            Stroke="Black">
            
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1" />
                    <SkewTransform />
                    <RotateTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        
        <Rectangle
            Grid.ColumnSpan="3"
            Width="689"
            Height="1"
            Margin="30,158,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            RenderTransformOrigin="0.5,0.5"
            Stroke="Black">
            
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1" />
                    <SkewTransform />
                    <RotateTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>

    </Grid>
</Window>
