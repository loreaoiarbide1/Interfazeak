<Window
    x:Class="Ariketa7.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ariketa7"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Kalkulagailua"
    Width="800"
    Height="550"
    mc:Ignorable="d">
    <Grid Margin="10" Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pantaila -->
        <TextBox
            x:Name="txtEmaitza"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="5"
            Height="64"
            Margin="0,0,0,10"
            Padding="10"
            VerticalAlignment="Center"
            Background="Yellow"
            FontSize="24"
            IsReadOnly="True"
            TextAlignment="Right"
            TextWrapping="NoWrap" />

        <!-- Lerroa 1 -->
        <Button x:Name="btnZazpi" Grid.Row="1" Grid.Column="0" Margin="5" Click="btnZazpi_Click" Content="7" FontSize="18" />
        <Button x:Name="btnZortzi" Grid.Row="1" Grid.Column="1" Margin="5" Click="btnZortzi_Click" Content="8" FontSize="18" />
        <Button x:Name="btnBederatzi" Grid.Row="1" Grid.Column="2" Margin="5" Click="btnBederatzi_Click" Content="9" FontSize="18" />
        <Button x:Name="btnGarbitu" Grid.Row="1" Grid.Column="3" Margin="5" Click="btnC_Click" Content="C" FontSize="14" Background="#FFB6C6" FontWeight="Bold" />
        <Button x:Name="btnCE" Grid.Row="1" Grid.Column="4" Margin="5" Click="btnCE_Click" Content="CE" FontSize="14" Background="#FFB6C6" FontWeight="Bold" />

        <!-- Lerroa 2 -->
        <Button x:Name="btnLau" Grid.Row="2" Grid.Column="0" Margin="5" Click="btnLau_Click" Content="4" FontSize="18" />
        <Button x:Name="btnBost" Grid.Row="2" Grid.Column="1" Margin="5" Click="btnBost_Click" Content="5" FontSize="18" />
        <Button x:Name="btnSei" Grid.Row="2" Grid.Column="2" Margin="5" Click="btnSei_Click" Content="6" FontSize="18" />
        <Button x:Name="btnZatiketa" Grid.Row="2" Grid.Column="3" Margin="5" Click="btnZatiketa_Click" Content="/" FontSize="18" Background="#FFE0B2" FontWeight="Bold" />
        <Button x:Name="btnKendu" Grid.Row="2" Grid.Column="4" Margin="5" Click="btnKendu_Click" Content="−" FontSize="18" Background="#FFE0B2" FontWeight="Bold" />

        <!-- Lerroa 3 -->
        <Button x:Name="btnBat" Grid.Row="3" Grid.Column="0" Margin="5" Click="btnBat_Click" Content="1" FontSize="18" />
        <Button x:Name="btnBi" Grid.Row="3" Grid.Column="1" Margin="5" Click="btnBi_Click" Content="2" FontSize="18" />
        <Button x:Name="btnHiru" Grid.Row="3" Grid.Column="2" Margin="5" Click="btnHiru_Click" Content="3" FontSize="18" />
        <Button x:Name="btnBiderketa" Grid.Row="3" Grid.Column="3" Margin="5" Click="btnBiderketa_Click" Content="×" FontSize="18" Background="#FFE0B2" FontWeight="Bold" />
        <Button x:Name="btnBatu" Grid.Row="3" Grid.Column="4" Margin="5" Click="btnBatu_Click" Content="+" FontSize="18" Background="#FFE0B2" FontWeight="Bold" />

        <!-- Lerroa 4 -->
        <Button x:Name="btnZero" Grid.Row="4" Grid.Column="0" Margin="5,5,10,5" Click="btnZero_Click" Content="0" FontSize="18" Grid.ColumnSpan="2" />
        <Button x:Name="btnKoma" Grid.Row="4" Grid.Column="2" Margin="5,5,5,5" Click="btnKoma_Click" Content="." FontSize="18" />
        <Button x:Name="btnBerdin" Grid.Row="4" Grid.Column="3" Margin="5,5,5,5" Click="btnBerdin_Click" Content="=" FontSize="18" Background="#C8E6C9" FontWeight="Bold" />
        <Button x:Name="btnPortzentaia" Grid.Row="4" Grid.Column="4" Margin="0,5,5,5" Click="btnPortzentaia_Click" Content="%" FontSize="18" Background="#FFE0B2" FontWeight="Bold" />
    </Grid>
</Window>
