<Window
    x:Class="Ariketa8.DatenAldea"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Daten Aldea"
    Width="400"
    Height="250"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize">
    <Grid Background="#F5F5F5">
        <!-- Lehenengo hasierako data eskatu -->
        <StackPanel x:Name="panel1HasierakoDataEskatu" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <Label Content="Sartu hasierako data (dd/mm/uuuu):" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBox
                x:Name="txtHasierakoa"
                Margin="0,0,0,30"
                Padding="8"
                TextAlignment="Center"
                FontSize="14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="40">
                <Button
                    x:Name="btnAurrera"
                    Width="100"
                    Margin="0,0,20,0"
                    Padding="10"
                    Click="btnAurrera_Click"
                    Content="Aurrera"
                />
                <Button
                    x:Name="btnUtzi1"
                    Width="100"
                    Padding="10"
                    Click="btnUtzi_Click"
                    Content="Utzi"
                />
            </StackPanel>
        </StackPanel>

        <!-- Amaierako data eskatu -->
        <StackPanel x:Name="panel2HilabeteakEskatu" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Visibility="Hidden">
            <Label x:Name="lblDataHasierakoa" Content="Hasierako data: " FontWeight="Bold" Margin="0,0,0,15" />

            <Label Content="Sartu amaierako data (dd/mm/uuuu):" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBox
                x:Name="txtAmaierakoa"
                Margin="0,0,0,30"
                Padding="8"
                TextAlignment="Center"
                FontSize="14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="40">
                <Button
                    x:Name="btnOnartu"
                    Width="100"
                    Margin="0,0,20,0"
                    Padding="10"
                    Click="btnOnartu_Click"
                    Content="Onartu"
                />
                <Button
                    x:Name="btnAtzera"
                    Width="100"
                    Margin="0,0,20,0"
                    Padding="10"
                    Click="btnAtzera_Click"
                    Content="Atzera"
                />
                <Button
                    x:Name="btnUtzi2"
                    Width="100"
                    Padding="10"
                    Click="btnUtzi_Click"
                    Content="Utzi"
                />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>